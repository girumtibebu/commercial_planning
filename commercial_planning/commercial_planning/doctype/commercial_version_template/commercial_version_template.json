{
 "doctype": "DocType",
 "name": "Commercial Version Template",
 "module": "Commercial Planning",
 "engine": "InnoDB",
 "field_order": [
  "template_name",
  "version_name",
  "column_break_a",
  "stage",
  "purpose",
  "rules_section",
  "trigger",
  "copy_from",
  "reference_role",
  "column_break_b",
  "freeze_source",
  "requires_approval",
  "editors_section",
  "editor_roles"
 ],
 "fields": [
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "version_name",
   "fieldtype": "Data",
   "label": "Version Name",
   "description": "Default name of versions made from this template",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "stage",
   "fieldtype": "Link",
   "label": "Stage",
   "options": "Commercial Version Stage",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "purpose",
   "fieldtype": "Link",
   "label": "Purpose",
   "options": "Commercial Version Purpose",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rules_section",
   "fieldtype": "Section Break",
   "label": "Rules"
  },
  {
   "fieldname": "trigger",
   "fieldtype": "Select",
   "label": "Trigger",
   "options": "Manual\nPlan created\nSales Order created\nProject created",
   "default": "Manual",
   "in_list_view": 1
  },
  {
   "fieldname": "copy_from",
   "fieldtype": "Select",
   "label": "Copy From",
   "options": "Latest version\nBaseline version\nBlank",
   "default": "Latest version"
  },
  {
   "fieldname": "reference_role",
   "fieldtype": "Select",
   "label": "Reference Role",
   "options": "\nBaseline\nBudget\nForecast",
   "description": "Role given to versions made from this template (Budget is given on approval)"
  },
  {
   "fieldname": "column_break_b",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "freeze_source",
   "fieldtype": "Check",
   "label": "Freeze Source",
   "description": "Freeze the version this one is copied from"
  },
  {
   "fieldname": "requires_approval",
   "fieldtype": "Check",
   "label": "Requires Approval",
   "description": "Only Commercial Management can freeze or approve it"
  },
  {
   "fieldname": "editors_section",
   "fieldtype": "Section Break",
   "label": "Who can edit"
  },
  {
   "fieldname": "editor_roles",
   "fieldtype": "Table",
   "label": "Editor Roles",
   "options": "Commercial Template Role"
  }
 ],
 "permissions": [
  {
   "role": "Commercial Planner",
   "read": 1
  },
  {
   "role": "Projects Manager",
   "read": 1
  },
  {
   "role": "Commercial Management",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "states": [],
 "autoname": "field:template_name",
 "naming_rule": "By fieldname"
}
